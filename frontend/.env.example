# Frontend env (copy to frontend/.env and edit if needed)
#
# Default: leave empty — Vite proxies /api to this PC's backend (127.0.0.1:8000).
#
# Shared access across two PCs (same admin data everywhere):
# 1. On PC-A run the backend with --host 0.0.0.0 (see scripts/start-backend.ps1).
# 2. On PC-B set this to PC-A's LAN IP, then restart npm run dev:
# VITE_API_BASE=http://192.168.1.10:8000
#
# Or simply open PC-A's frontend from PC-B's browser:
#   http://PC-A-LAN-IP:5173
# (no .env change needed — one backend, one database.)

# VITE_API_BASE=
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
