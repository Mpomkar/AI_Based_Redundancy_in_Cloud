# Optional backend configuration (copy to backend/.env and edit)
# cp backend/.env.example backend/.env

# Reject uploads when content match >= this percent (default: 92)
CONTENT_MATCH_REJECT_THRESHOLD_PERCENT=92

# ML redundant probability threshold used with similarity rules (default: 0.62)
# REDUNDANT_THRESHOLD=0.62

# SQLite database URL (default: backend/app.db)
# DATABASE_URL=sqlite:///C:/path/to/backend/app.db

# Max characters extracted from PDF/DOCX for similarity (default: 120000)
# MAX_PDF_TEXT_CHARS=120000

# JWT auth (change secret in production)
# JWT_SECRET_KEY=change-me-in-production-cloud-redundancy-ai
# JWT_EXPIRE_MINUTES=480

# --- File storage (Desktop by default) ---
# Accepted uploads are saved under Desktop/Uploaded Files/uploads/<user_id>/
# Override if you need a custom path (e.g. shared network drive for multi-PC):
# STORAGE_DIR=C:/Users/You/Desktop/Uploaded Files

# --- Multi-PC / shared admin data ---
# Run ONE backend (scripts/start-backend.ps1 listens on 0.0.0.0).
# All other PCs must open that machine's frontend URL, e.g. http://192.168.1.10:5173
# Do NOT start a separate backend on each laptop — each local app.db is isolated.
# Files live on the backend PC's Desktop "Uploaded Files" folder (shared via that API).
# Optional: point DATABASE_URL / STORAGE_DIR at a shared network path if you know what you are doing.
# DATABASE_URL=sqlite:///C:/shared/cloud-redundancy/app.db
# STORAGE_DIR=C:/shared/cloud-redundancy/Uploaded Files

